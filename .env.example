# ================== StalSell ==================
# Скопируй этот файл в .env и заполни своими данными:
#   cp .env.example .env

# Данные от API STALZONE (получить у @stalcraft_api_bot)
STALZONE_CLIENT_ID=
STALZONE_CLIENT_SECRET=

# Настройки приложения
APP_NAME=StalSell
DEBUG=False
DATABASE_URL=sqlite:///./data/stalsell.db

# 🔑 Секретный ключ для JWT (сгенерируй командой):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=